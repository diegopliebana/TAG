                 "capacity":  10000
             },
    "optimization":  {
                         "updates_per_cycle":  64,
                         "batch_size":  64,
                         "learning_rate":  0.001
                     },
    "evaluation":  {
                       "enabled":  false
                   },
    "limits":  {
                   "max_moves":  4096
               },
    "output":  {
                   "model_file":  "results/cantstop-browser-model.json",
                   "checkpoint_file":  "results/cantstop-browser-training.pt",
                   "report_file":  "results/cantstop-browser-results.json"
               }
