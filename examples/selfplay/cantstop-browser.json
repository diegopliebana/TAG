{
    "schema_version":  1,
    "game":  "cantstop",
    "players":  2,
    "seed":  42,
    "cycles":  20,
    "games_per_cycle":  32,
    "parallel_games":  4,
    "search":  {
                   "schema_version":  1,
                   "tree_policy":  "puct",
                   "rollout_length":  0,
                   "budgets":  {
                                   "iterations":  128
                               },
                   "state_evaluator":  {
                                           "name":  "network_value"
                                       },
                   "puct_preferences":  {
