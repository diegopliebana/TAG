                                            "evaluator":  {
                                                              "name":  "network_policy"
                                                          }
                                        }
               },
    "model":  {
                  "payloads":  [
                                   "permanent",
                                   "temporary",
                                   "owners",
                                   "dice",
                                   "context"
                               ],
                  "hidden_sizes":  [
                                       32,
                                       32
                                   ],
                  "value_output":  "players"
              },
    "exploration":  {
