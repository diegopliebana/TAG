"""Types for the compiled module. The public interface is documented in api.py."""
from typing import Any

class StalePositionError(RuntimeError): ...
class ClosedGameError(RuntimeError): ...
class EvaluationError(RuntimeError): ...

class EvaluationHandle:
    @property
    def id(self) -> int: ...
    @property
    def offset(self) -> int: ...

class OpenLinesEvaluator:
    def evaluate(self, identity: dict[str, Any], actor: int, cells: Any,
                 results: Any, action_ids: Any) -> Any: ...

class Position:
    @property
    def instance(self) -> int: ...
    @property
    def revision(self) -> int: ...

class Game:
    @property
    def position(self) -> Position: ...
    @property
    def next_player(self) -> int | None: ...
    @property
    def seed(self) -> int | None: ...
    def payload_names(self) -> list[str]: ...
    def spec(self) -> dict[str, Any]: ...
    def start_mcts(self, settings_json: str, observers: str, payloads: list[str],
                   values_name: str, policy_name: str, max_rows: int = 4096,
                   max_bytes: int = 67108864) -> MctsSearch: ...
    def open_lines_evaluator(self) -> OpenLinesEvaluator: ...
    def observe(self, observer: int, payloads: list[str]) -> dict[str, Any]: ...
    def apply(self, action_id: int, position: Position, actor: int | None = None) -> Position: ...
    def reset(self) -> Position: ...
    def clone(self) -> Game: ...
    def close(self) -> None: ...
    def set_controller(self, player: int, checkpoint: dict[str, Any] | None) -> Position: ...
    def controller_checkpoint(self, player: int) -> dict[str, Any] | None: ...
    def prepare_evaluation(self) -> dict[str, Any]: ...
    def finish_evaluation(self, handle: EvaluationHandle, values: Any, action_ids: Any,
                          evaluator: dict[str, Any]) -> dict[str, Any]: ...
    def commit_evaluation(self, handle: EvaluationHandle) -> Position: ...
    def cancel_evaluation(self, handle: EvaluationHandle) -> None: ...
    def advance(self, max_moves: int = 1024) -> dict[str, Any]: ...
    def resume(self, handle: EvaluationHandle, values: Any, action_ids: Any,
               evaluator: dict[str, Any], max_moves: int = 1024) -> dict[str, Any]: ...

def create(name: str, parameters: dict[str, int] | None = None, players: int = 2,
           max_cells: int = 4096, max_bytes: int = 67108864) -> Game: ...

def create_json(name: str, parameters_json: str, players: int = 2,
                max_cells: int = 4096, max_bytes: int = 67108864) -> Game: ...

def registered_games() -> list[str]: ...

def create_controller(settings: dict[str, Any], seed: int) -> dict[str, Any]: ...
def parse_mcts_settings(text: str) -> str: ...
def automatic_search_seed() -> int: ...

class MctsSearch:
    @property
    def settings_json(self) -> str: ...
    def advance(self) -> dict[str, Any]: ...
    def respond(self, search: int, sequence: int, kind: str, values: Any,
                scalar_player: int | None = None, validate_only: bool = False) -> dict[str, Any]: ...
    def cancel(self) -> None: ...

class NativeOpponents:
    def __init__(self, game: Game, candidate: int, agents_json: str) -> None: ...
    def advance(self, game: Game, max_actions: int | None = None, trace: bool = False) -> str: ...
    def apply_candidate(self, game: Game, id: int, position: Position) -> str: ...
    def state(self, game: Game) -> str: ...

class EvaluationGroupHandle:
    @property
    def id(self) -> int: ...

class GameBatch:
    def __init__(self, games: list[Game], max_group_rows: int = 4096,
                 max_bytes: int = 67108864) -> None: ...
    @property
    def pending_count(self) -> int: ...
    def advance(self, max_moves_per_game: int = 1024) -> dict[str, Any]: ...
    def resume(self, handle: EvaluationGroupHandle, values: Any, action_ids: Any,
               evaluator: dict[str, Any], max_moves_per_game: int = 1024) -> dict[str, Any]: ...
    def cancel(self, handle: EvaluationGroupHandle) -> None: ...
    def cancel_all(self) -> None: ...
    def close(self) -> None: ...

class ResetCandidate:
    @property
    def output(self) -> dict[str, Any]: ...

class Episode:
    def __init__(self, config: dict[str, Any]) -> None: ...
    def spec(self) -> dict[str, Any]: ...
    def prepare_reset(self, seed: int, teacher_seed: int | None = None) -> ResetCandidate: ...
    def commit_reset(self, candidate: ResetCandidate) -> None: ...
    def step(self, action: int) -> dict[str, Any]: ...
    def step_teacher(self) -> dict[str, Any]: ...
    def fail(self) -> None: ...
    def close(self) -> None: ...
    @property
    def status(self) -> str: ...

class BatchResetCandidate:
    @property
    def output(self) -> dict[str, Any]: ...

class EpisodeBatch:
    def __init__(self, episodes: list[Episode], max_bytes: int = 67108864) -> None: ...
    def step(self, actions: list[int | None]) -> dict[str, Any]: ...
    def step_teacher(self, active: list[bool]) -> dict[str, Any]: ...
    def prepare_resets(self, indices: list[int], seeds: list[int | None],
                       teacher_seeds: list[int | None] | None = None) -> BatchResetCandidate: ...
    def commit_resets(self, candidate: BatchResetCandidate, indices: list[int]) -> None: ...
    def fail(self, indices: list[int]) -> None: ...
    def statuses(self) -> list[str]: ...
    def close(self) -> None: ...
